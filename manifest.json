{
  "manifest_version": 3,
  "name": "Auto Ad Skipper",
  "version": "2.0.0",
  "description": "Automatically clicks the Skip Ad button on YouTube. Mutes ad audio and handles SPA navigation.",

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },

  "permissions": [],

  "host_permissions": [
    "*://*.youtube.com/*"
  ],

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "auto-ad-skipper@local.dev",
      "strict_min_version": "112.0"
    }
  }
}